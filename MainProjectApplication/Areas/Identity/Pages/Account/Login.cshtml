@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 text-center mb-4">Welcome back</h1>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Password" />
                <label asp-for="Input.Password"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe" class="form-check-label">Stay signed in</label>
            </div>

            <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Sign in</button>

            <p class="text-center mt-3 mb-1"><a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a></p>
            <p class="text-center">New here? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>
            <p class="text-center">Are you an existing artist? <a asp-page="./ArtistLogin">Log in here</a></p>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <p class="text-center text-muted mt-3">Or sign in with</p>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins)
                {
                    <button type="submit" class="btn btn-outline-secondary w-100 mb-2" name="provider" value="@provider.Name">@provider.DisplayName</button>
                }
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
