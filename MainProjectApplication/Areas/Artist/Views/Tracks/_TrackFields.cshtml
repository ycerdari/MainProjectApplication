@model TrackUploadViewModel
@{
    var isEdit = Model.Id != 0;
}

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

<section class="card card-body mb-3">
    <h2 class="h5">1. Audio file</h2>
    @if (isEdit && !string.IsNullOrEmpty(Model.CurrentAudioPath))
    {
        <audio controls preload="none" src="@Model.CurrentAudioPath" class="mb-2"></audio>
        <div class="small text-muted mb-2">Current file: @Model.CurrentFileName. Leave the field empty to keep it.</div>
    }
    <input asp-for="AudioFile" type="file" class="form-control"
           accept=".mp3,.m4a,.wav,.flac,.aac,.ogg,.oga,.opus,.aiff,.aif,.wma,.raw,.pcm,.alac,.ape,.amr,audio/*" />
    <div class="form-text">MP3, M4A, WAV, FLAC, AAC, OGG, OPUS, AIFF, WMA, RAW and other audio formats. Up to 100 MB.</div>
    <span asp-validation-for="AudioFile" class="text-danger"></span>
    <input asp-for="DurationSeconds" type="hidden" />
    <input asp-for="Id" type="hidden" />
</section>

<section class="card card-body mb-3">
    <h2 class="h5">2. Details</h2>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="FeaturedArtists" class="form-label"></label>
            <input asp-for="FeaturedArtists" class="form-control" placeholder="Separate names with commas" />
        </div>
        <div class="col-md-6">
            <label asp-for="ReleaseType" class="form-label"></label>
            <select asp-for="ReleaseType" asp-items="Html.GetEnumSelectList<ReleaseType>()" class="form-select"
                    data-other="@((int)ReleaseType.Other)"></select>
        </div>
        <div class="col-md-6" id="release-other-box">
            <label asp-for="ReleaseTypeOther" class="form-label"></label>
            <input asp-for="ReleaseTypeOther" class="form-control" placeholder="e.g. Split EP" />
        </div>
        <div class="col-md-6">
            <label asp-for="ReleaseTitle" class="form-label"></label>
            <input asp-for="ReleaseTitle" class="form-control" placeholder="Leave empty for a single" />
        </div>
        <div class="col-md-6">
            <label asp-for="Visibility" class="form-label"></label>
            <select asp-for="Visibility" asp-items="Html.GetEnumSelectList<TrackVisibility>()" class="form-select"></select>
            <div class="form-text">Public tracks appear in Browse and Search. Unlisted and Draft do not.</div>
        </div>
    </div>
    <div class="form-check mt-3">
        <input asp-for="IsExplicit" class="form-check-input" />
        <label asp-for="IsExplicit" class="form-check-label"></label>
    </div>
</section>

<section class="card card-body mb-3">
    <h2 class="h5">3. Genres</h2>
    <div class="small text-muted mb-2" id="genre-count">Pick up to 5.</div>
    <div class="d-flex flex-wrap gap-2" role="group" aria-label="Genres">
        @foreach (var g in Model.AllGenres)
        {
            <input type="checkbox" class="btn-check genre-check" name="GenreIds" value="@g.Id" id="genre-@g.Id"
                   data-others="@(g.Name == "Others")" @(Model.GenreIds.Contains(g.Id) ? "checked" : "") />
            <label class="btn btn-outline-secondary btn-sm" for="genre-@g.Id">@g.Name</label>
        }
    </div>
    <span asp-validation-for="GenreIds" class="text-danger"></span>
    <div class="mt-3" id="other-genre-box">
        <label asp-for="OtherGenre" class="form-label"></label>
        <input asp-for="OtherGenre" class="form-control" placeholder="e.g. Kundiman" />
    </div>
</section>

@if (!isEdit)
{
    <section class="card card-body mb-3">
        <h2 class="h5">4. Rights</h2>
        <div class="form-check">
            <input asp-for="ConfirmRights" class="form-check-input" />
            <label asp-for="ConfirmRights" class="form-check-label"></label>
        </div>
        <span asp-validation-for="ConfirmRights" class="text-danger"></span>
    </section>
}
