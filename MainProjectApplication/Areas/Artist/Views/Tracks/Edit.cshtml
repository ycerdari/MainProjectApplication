@model TrackUploadViewModel
@{
    ViewData["Title"] = "Edit track";
}

<h1 class="h3">Edit track</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data" style="max-width:820px">
    <partial name="_TrackFields" model="Model" />
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/track-upload.js"></script>
    <script src="~/js/artist-upload.js"></script>
}
