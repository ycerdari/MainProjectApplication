@model TrackUploadViewModel
@{
    ViewData["Title"] = "Upload a track";
}

<h1 class="h3">Upload a track</h1>
<p class="text-muted">Share original music. Public tracks appear in Browse and Search right away.</p>

<form asp-action="Create" method="post" enctype="multipart/form-data" style="max-width:820px">
    <partial name="_TrackFields" model="Model" />
    <button type="submit" class="btn btn-primary">Upload</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/track-upload.js"></script>
    <script src="~/js/artist-upload.js"></script>
}
